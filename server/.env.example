# Prototype credentials only. Use a secret manager and per-device/session
# attestation before making this service public; the static app token is not a
# production authentication mechanism.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
SEENA_APP_TOKEN=replace-with-a-long-random-prototype-token
# Public deployments must configure all three durable quota values. Missing or
# partial values fail paid provider calls closed with 503. Set this exact value
# only for an intentionally local development server without KV access.
SEENA_DEPLOYMENT_MODE=
SEENA_KV_REST_API_URL=
SEENA_KV_REST_API_TOKEN=
SEENA_DAILY_COST_UNIT_LIMIT=
